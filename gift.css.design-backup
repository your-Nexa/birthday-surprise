* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    overflow-x: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg,#120024,#3b0a63,#7025b5);
    color: white;
    position: relative;
    padding: 25px 12px;
}

.container {
    position: relative;
    z-index: 10;
    text-align: center;
    width: 100%;
    max-width: 500px;
}

h1 {
    font-size: clamp(27px,7vw,40px);
    color: #ffb6d0;
    margin-bottom: 18px;
    text-shadow: 0 0 15px #ff4f9a;
}

p {
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 15px;
}

.stars {
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image:
    radial-gradient(2px 2px at 20% 30%,white,transparent),
    radial-gradient(2px 2px at 70% 20%,white,transparent),
    radial-gradient(3px 3px at 40% 70%,white,transparent),
    radial-gradient(2px 2px at 85% 80%,white,transparent);
    animation: twinkle 4s infinite;
}

@keyframes twinkle {
    0%,100% { opacity: .4; }
    50% { opacity: 1; }
}

.glow {
    position: fixed;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle,rgba(255,105,180,.35),transparent 70%);
    animation: glow 2s infinite;
    pointer-events: none;
}

@keyframes glow {
    50% { transform: scale(1.3); opacity: .6; }
}

.cake-area {
    position: relative;
    width: 100%;
    height: 340px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 15px auto;
}

.cake {
    position: relative;
    width: 290px;
    height: 250px;
    cursor: pointer;
    filter: drop-shadow(0 0 22px rgba(255,105,180,.5));
    transition: transform .3s;
    z-index: 2;
}

.cake:active {
    transform: scale(.97);
}

.candles {
    position: absolute;
    top: 10px;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 28px;
    z-index: 5;
}

.candle {
    position: relative;
    width: 13px;
    height: 53px;
    border-radius: 5px 5px 2px 2px;
    background: repeating-linear-gradient(
        135deg,#fff 0px,#fff 5px,#ff70a5 5px,#ff70a5 10px
    );
    box-shadow: 0 0 8px rgba(255,255,255,.5);
}

.flame {
    position: absolute;
    width: 15px;
    height: 23px;
    background: linear-gradient(#fff7a8,#ffb300,#ff5722);
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    top: -25px;
    left: -1px;
    transform-origin: bottom;
    animation: flicker .5s infinite alternate;
    box-shadow: 0 0 15px #ffb300;
}

@keyframes flicker {
    from { transform: rotate(-45deg) scale(1); }
    to { transform: rotate(-42deg) scale(.85); }
}

.cake-top {
    position: absolute;
    top: 62px;
    left: 25px;
    width: 240px;
    height: 45px;
    border-radius: 50%;
    background: #ffb6d0;
    border: 5px solid #fff0f6;
    z-index: 4;
    display: flex;
    justify-content: space-around;
    align-items: center;
    font-size: 19px;
}

.cream {
    position: absolute;
    inset: 5px;
    border-radius: 50%;
    background: #ff80ad;
}

.cake-top span {
    position: relative;
    z-index: 2;
}

.cake-body {
    position: absolute;
    top: 82px;
    left: 25px;
    width: 240px;
    height: 105px;
    background: linear-gradient(90deg,#f84d89,#ff9aba,#ed3979);
    border-radius: 0 0 18px 18px;
    border: 3px solid #ffb6d0;
    z-index: 3;
}

.icing {
    position: absolute;
    top: -4px;
    left: -3px;
    width: 240px;
    height: 20px;
    background: #fff0f6;
    border-radius: 50%;
}

.drips {
    position: absolute;
    top: 5px;
    left: 20px;
    width: 200px;
    height: 25px;
    background: radial-gradient(ellipse at top,#fff0f6 60%,transparent 62%);
}

.cake-bottom {
    position: absolute;
    top: 180px;
    left: 15px;
    width: 260px;
    height: 25px;
    background: #ff8ab4;
    border-radius: 50%;
    border-bottom: 5px solid #fff0f6;
    z-index: 2;
}

.plate {
    position: absolute;
    bottom: 25px;
    width: 310px;
    height: 27px;
    border-radius: 50%;
    background: linear-gradient(#fff,#ffb6d0);
    box-shadow: 0 8px 18px rgba(0,0,0,.3);
}

.cake-slice {
    position: absolute;
    top: 90px;
    right: 25px;
    width: 100px;
    height: 95px;
    background: linear-gradient(135deg,#ffb6d0,#ff4f89);
    clip-path: polygon(0 0,100% 50%,0 100%);
    opacity: 0;
    z-index: 6;
    transition: transform 1s, opacity .5s;
}

.knife {
    position: absolute;
    top: 45px;
    right: 35px;
    font-size: 35px;
    opacity: 0;
    z-index: 8;
    transform: rotate(-45deg);
}

.cake.cutting .knife {
    opacity: 1;
    animation: cutCake .9s forwards;
}

@keyframes cutCake {
    0% { transform: translate(50px,-30px) rotate(-45deg); }
    100% { transform: translate(-100px,90px) rotate(-45deg); }
}

.cake.cut .cake-slice {
    opacity: 1;
    transform: translate(75px,25px) rotate(12deg);
}

.cake.cut .cake-body {
    clip-path: polygon(0 0,100% 0,75% 100%,0 100%);
}

.cake.extinguished .flame {
    display: none;
}

#status {
    color: #ffe0ed;
    min-height: 30px;
    font-size: 18px;
}

#nextButton {
    border: none;
    background: linear-gradient(135deg,#ff70a5,#ff3380);
    color: white;
    padding: 17px 35px;
    font-size: 19px;
    font-weight: bold;
    border-radius: 50px;
    margin-top: 15px;
    cursor: pointer;
    box-shadow: 0 0 25px rgba(255,70,150,.5);
    animation: appear .8s ease;
}

#nextButton[hidden] {
    display: none;
}

#nextButton:active {
    transform: scale(.95);
}

@keyframes appear {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

@media(max-width:380px) {
    .cake {
        transform: scale(.9);
    }
}
