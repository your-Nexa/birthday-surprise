<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday Anamika 🎂</title>
<link rel="stylesheet" href="gift.css">
</head>
<body>

<div class="stars"></div>
<div class="glow"></div>

<div class="container">

    <h1>🎂 Happy Birthday Anamika!</h1>

    <p id="instruction">
        Make a wish and tap the candles! ❤️
    </p>

    <div class="cake-area" id="cakeArea">

        <div class="cake" id="cake">

            <div class="candles">
                <div class="candle candle-one">
                    <div class="flame"></div>
                </div>
                <div class="candle candle-two">
                    <div class="flame"></div>
                </div>
                <div class="candle candle-three">
                    <div class="flame"></div>
                </div>
            </div>

            <div class="cake-top">
                <div class="cream"></div>
                <span>❤️</span>
                <span>🌸</span>
                <span>❤️</span>
            </div>

            <div class="cake-body">
                <div class="icing"></div>
                <div class="drips"></div>
            </div>

            <div class="cake-bottom"></div>

            <div class="cake-slice" id="cakeSlice"></div>

            <div class="knife" id="knife">🔪</div>

        </div>

        <div class="plate"></div>

    </div>

    <p id="status">✨ Make a beautiful birthday wish!</p>

    <button id="nextButton" hidden>
        💌 Next Page
    </button>

</div>

<script src="gift.js"></script>

</body>
</html>
